{
  // Type-checks the Pages Functions (npm run typecheck:functions). They
  // run on Cloudflare's Workers runtime, not in the browser, so they get
  // Workers types instead of the DOM ones the site uses (../tsconfig.json).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["./**/*.ts"]
}

{
  "name": "apn-real-estate-agency-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "pages": "node scripts/fetch-listings.mjs && node scripts/build-pages.mjs",
    "dev": "npm run pages && vite",
    "dev:sample": "node scripts/fetch-listings.mjs --sample && node scripts/build-pages.mjs && vite",
    "build": "npm run pages && tsc -b && tsc -p functions && vite build && vite build --ssr src/server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck:functions": "tsc -p functions"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-imagetools": "^7.1.1"
  }
}

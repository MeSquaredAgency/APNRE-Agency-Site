# GA4 (G-WDLJLYGJCY) is now configured as a Google tag inside the GTM
# container below instead of being built directly into the bundle — no
# VITE_GA4_ID here anymore for that reason.
#
# Meta Pixel ID is not a secret — it's visible in every visitor's page
# source regardless — so it's simplest to just commit the real value
# here rather than set it as a Cloudflare Pages dashboard env var. (If
# you'd rather keep it out of source for any reason, blank this and set
# VITE_META_PIXEL_ID in the Cloudflare Pages project's Environment
# variables instead — that overrides this file at build time. See
# src/partials/head-shared.html for why the key must exist here even
# when blank.)
VITE_META_PIXEL_ID=1546265206271738

# Google Tag Manager container ID — same non-secret reasoning as above.
VITE_GTM_ID=GTM-P5H7NTCF

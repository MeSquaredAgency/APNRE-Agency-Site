# Cloudflare Pages response headers. See
# https://developers.cloudflare.com/pages/configuration/headers/
#
# No enforced Content-Security-Policy yet: GTM loads whatever tags are
# set up in the container, so a strict script policy would silently break
# analytics whenever a tag is added there. frame-ancestors on its own is
# safe and stops other sites framing these pages (clickjacking).
#
# The Report-Only policy below blocks nothing. Browsers only log what it
# would have blocked (DevTools console, "Content-Security-Policy-Report-
# Only"), which shows what an enforced policy needs to allow: the GTM
# and GA4 tags (Google tag gateway included), Google Ads conversions,
# the Meta Pixel, Google address search, Turnstile and the Pexels photos. Once a few weeks pass with nothing unexpected logged,
# rename the header to Content-Security-Policy (keeping frame-ancestors).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://connect.facebook.net https://maps.googleapis.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://www.google.com https://www.google.com.au https://googleads.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://maps.googleapis.com https://places.googleapis.com https://challenges.cloudflare.com https://cloudflareinsights.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com https://www.facebook.com https://td.doubleclick.net; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY

# Built JS, CSS and images have a content hash in their file name, so a
# changed file always gets a new URL: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The hero video and poster keep fixed names, so cache for a day and let
# the browser revalidate after that. Rename the files when replacing
# them to update everyone straight away.
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400

# Listing photos copied from PropertyMe by the feed server
# (docs/listings-feed.md). Each upload gets a new name, so a file never
# changes: safe to cache for a year.
/listing-photos/*
  Cache-Control: public, max-age=31536000, immutable

# Blog photos keep the names the post refers to, so the same rule as the
# video: a day, then revalidate in the background.
/blog-images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted fonts for the whole site (src/partials/fonts-agency.html and
# fonts-landlords.html).
# Rename a file if it's ever replaced, since browsers keep it for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
